{:paths ["src"]
 :version "0.1.0"
 ;; kotoba-lang/json — Layer 1 (data) of the kotoba foundational stdlib.
 ;; Pure-Clojure JSON encode/decode with no host dependency, so the same code
 ;; runs on kotoba-WASM instead of punting JSON parsing to the host. Zero
 ;; third-party runtime deps; .cljc.
 ;; See ADR-kotoba-lang-foundational-stdlib.md.
 :deps {
        io.github.kotoba-lang/json-decode
        {:git/url "https://github.com/kotoba-lang/json-decode.git"
         :git/sha "f7b03f38002e6d894800fa2d8f83003af55f1bbe"}
        io.github.kotoba-lang/json-encode
        {:git/url "https://github.com/kotoba-lang/json-encode.git"
         :git/sha "96accd53e7da06e2a36fa3f9bdcfaf85835fde47"}
        io.github.kotoba-lang/json-json
        {:git/url "https://github.com/kotoba-lang/json-json.git"
         :git/sha "aecd6042a8e344198080541e8aafb97527ffe915"}

        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
